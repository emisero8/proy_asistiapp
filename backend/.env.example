# Copiar a backend/.env y completar. El .env real NO se commitea (está en .gitignore).
# Solo hace falta lo que quieras cambiar: lo que no esté acá usa los valores por defecto.
# Sin comillas en los valores. Las variables de entorno reales tienen prioridad sobre este archivo.

# SMTP (ejemplo con Gmail; ver README, sección Envío de mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=tu_cuenta@gmail.com
SMTP_PASSWORD=app_password_de_16_caracteres

# Mercado Pago OAuth: vincular la cuenta de cada Organizador (PLAN_MEJORAS 8.4). Salen del panel de developers
# de Mercado Pago, en las credenciales de producción de la aplicación. Sin comillas. NUNCA commitear los valores.
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=
# Tiene que coincidir exactamente con la Redirect URL cargada en la aplicación (ngrok en local).
MP_OAUTH_REDIRECT_URI=
# Clave con la que se cifran en la base los tokens de Mercado Pago de los Organizadores (AES-256: 32 bytes en Base64).
# En desarrollo se puede omitir (hay una clave pública de desarrollo); en producción es obligatoria y secreta.
# Generar una:  openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Mercado Pago, cobro de entradas y créditos. Guía completa: docs/tecnica/MERCADOPAGO_COBRO.md
# ─────────────────────────────────────────────────────────────────────────────────────────────
# MODO DE DESARROLLO (recomendado si no vas a tocar Mercado Pago): cobra con la cuenta de la plataforma, en sandbox.
# Un Organizador sin cuenta vinculada publica igual. En producción tiene que ser true (es el valor por defecto).
MP_EXIGIR_CUENTA_VINCULADA=false
# Access Token de las credenciales de PRUEBA de la aplicación (panel de developers). Se pide por un canal privado.
MP_ACCESS_TOKEN=
# Claves secretas de Webhooks del panel de la aplicación (Webhooks → Configurar notificaciones → Clave secreta).
# Hay UNA POR MODO: MP_WEBHOOK_SECRET es la de la pestaña "Modo de prueba" (pagos de sandbox) y
# MP_WEBHOOK_SECRET_PRODUCCION la de "Modo productivo" (dinero real). Se acepta un aviso firmado con cualquiera
# de las dos que esté cargada. En producción alcanza con la productiva. Solo si probás el webhook con túnel.
MP_WEBHOOK_SECRET=
MP_WEBHOOK_SECRET_PRODUCCION=
# true en producción. En local se puede dejar en true si cargaste las claves de arriba.
MP_VALIDAR_FIRMA=false
# HTTPS público para recibir el webhook y la vuelta del OAuth (ngrok en local, con TU dominio). Sin túnel se omite.
# ngrok http --url=<tu-dominio>.ngrok-free.dev 8080
BACKEND_PUBLIC_URL=
# Solo si el frontend no corre en http://localhost:5173.
FRONTEND_BASE_URL=

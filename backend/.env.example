# Copiar a backend/.env y completar. El .env real NO se commitea (está en .gitignore).
# Solo hace falta lo que quieras cambiar: lo que no esté acá usa los valores por defecto.
# Sin comillas en los valores. Las variables de entorno reales tienen prioridad sobre este archivo.

# SMTP (ejemplo con Gmail; ver README, sección Envío de mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=tu_cuenta@gmail.com
SMTP_PASSWORD=app_password_de_16_caracteres
